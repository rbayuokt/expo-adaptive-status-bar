{
  "name": "expo-adaptive-status-bar-example",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@rbayuokt/expo-adaptive-status-bar": "file:..",
    "expo": "~58.0.14",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.15",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-status-bar": "~58.0.3",
    "expo-video": "~58.0.11",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "npm --prefix .. run prepare && expo run:ios",
    "ios:release": "npm --prefix .. run prepare && expo run:ios --configuration Release --no-bundler",
    "ios:device:release": "npm --prefix .. run prepare && expo run:ios --device --configuration Release --no-bundler",
    "android": "npm --prefix .. run prepare && expo run:android",
    "android:release": "npm --prefix .. run prepare && expo run:android --variant release --no-bundler",
    "android:device:release": "npm --prefix .. run prepare && expo run:android --device --variant release --no-bundler",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": ".."
    }
  }
}
